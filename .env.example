# Servidor
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://feedbackai:feedbackai@localhost:5432/feedbackai

# Redis (BullMQ + Socket.io adapter)
REDIS_URL=redis://localhost:6379

# Autenticación
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# IA (Claude API)
# Si ANTHROPIC_API_KEY está vacío o MOCK_AI=true, el worker usa el analizador mock.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
MOCK_AI=false
